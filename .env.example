ALPHAVANTAGE_API_KEY=your_alpha_vantage_key_here
GEMINI_API_KEY=your_gemini_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Public SEC requests do not need a key. A descriptive User-Agent is recommended.
SEC_USER_AGENT=stock-agent/1.0 your_email@example.com
# Cloud dashboard transport is read-only. Keep the signing secret private.
V12_DASHBOARD_SYNC_SECRET=replace_with_a_long_random_secret
# Configure exactly one source after choosing private cloud storage.
V12_DASHBOARD_SNAPSHOT_URL=https://example.invalid/v12_dashboard.json

# Preferred private Supabase Storage transport. Keep the secret key server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_supabase_secret_key
V12_DASHBOARD_SUPABASE_BUCKET=v12-dashboard
V12_DASHBOARD_SUPABASE_OBJECT=v12_dashboard.json
